ECHO_MODEL_PROVIDER=stub
ECHO_MODEL_NAME=local-stub
ECHO_ENVIRONMENT=production
ECHO_ROOT=/app
ECHO_DATABASE_PATH=data/echo.sqlite3
ECHO_JOURNAL_PATH=data/echo_journal.jsonl
ECHO_ECONOMY_STATE_PATH=data/economy_state.json
ECHO_ADMIN_API_KEY_FILE=/run/secrets/admin_api_key
ECHO_USER_JWT_SECRET_FILE=/run/secrets/user_jwt_secret
# Governance signing falls back to the user/admin secrets above. Prefer a dedicated
# ECHO_GOVERNANCE_COOKIE_SECRET value supplied by the deployment secret manager.
ECHO_VECTOR_BACKEND=none
ECHO_ASSET_PROVIDER=none
ECHO_SCHEDULER_ENABLED=false
ECHO_SCHEDULER_RUN_ON_START=false
ECHO_AUTO_GIT_COMMIT=false
